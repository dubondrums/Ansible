---
site_interfaces:
{% for dev_name, dev in parsed_devices.items() %}
  {{ dev_name }}:
    interfaces:
{% for iface in dev.interfaces %}
      - name: {{ iface.name }}
        description: "{{ iface.description }}"
{% if iface.ip_address %}
        ip_address: {{ iface.ip_address }}
{% endif %}
{% if iface.netmask %}
        netmask: {{ iface.netmask }}
{% endif %}
{% if iface.routed %}
        routed: {{ iface.routed }}
{% endif %}
{% if iface.mode %}
        mode: {{ iface.mode }}
{% endif %}
{% if iface.allowed_vlans %}
        allowed_vlans: "{{ iface.allowed_vlans }}"
{% endif %}
{% if iface.native_vlan %}
        native_vlan: {{ iface.native_vlan }}
{% endif %}
{% if iface.access_vlan %}
        access_vlan: {{ iface.access_vlan }}
{% endif %}
{% if iface.vlan_id %}
        vlan_id: {{ iface.vlan_id }}
{% endif %}
{% endfor %}
{% endfor %}